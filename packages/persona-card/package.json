{
  "name": "dsh-persona-card",
  "version": "1.0.0",
  "description": "人设卡：在设置面板里写一张人设卡，注入系统提示词最高优先级段；支持全局开关与单会话覆盖。",
  "type": "module",
  "author": "Summer77177",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Summer77177/dsh-persona-suite.git",
    "directory": "packages/persona-card"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "system-prompt"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node selftest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
